{
  "tasks": {
    "gen-cauti": "deno run --allow-read --allow-write src/site/GPS/generate/gps.ts CAUTI",
    "min-cauti": "deno bundle src/site/GPS/cauti-gps-gen.html --outdir dist cauti-gps.html --minify",
    "updog": "deno run --allow-read --allow-write --allow-run src/tasks.ts build media links"
  },
  "compilerOptions": {
    "checkJs": true,
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@^1.1.6"
  }
}
